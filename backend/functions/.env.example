# Local emulator env — copy to .env and fill in.
# Do NOT commit real secrets; these names are read by src/config.ts.

GCLOUD_PROJECT=koomzo-workflow
REGION=us-central1

# Pub/Sub topic the engine publishes step messages to
STEP_TOPIC=workflow-steps

# Cloud Tasks queue used for delays + SLA timers
TASKS_QUEUE=workflow-timers
TASKS_LOCATION=us-central1

# Base URL of the deployed HTTPS functions (used to build timer callback targets)
FUNCTIONS_BASE_URL=https://us-central1-koomzo-workflow.cloudfunctions.net

# Shared secret for verifying inbound webhook signatures (Secret Manager ref in prod)
WEBHOOK_SIGNING_SECRET=dev-only-change-me
